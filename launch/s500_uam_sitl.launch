<?xml version="1.0"?>
<launch>
    <!-- settings -->
    <arg name="vehicle" default="s500_uam"/>
    <arg name="world_name" default="table_beer_with_stand"/>
    <arg name="model_type" default="real"/>
    <arg name="arm_control_mode" default="position"/>
    
    <arg name="world" default="$(find eagle_mpc_python)/worlds/$(arg world_name).world"/>
    
    <!-- Select SDF file based on model type -->
    <arg name="sdf_file" value="$(find eagle_mpc_python)/models/sdf/s500_uam/s500_uam_real.sdf" if="$(eval arg('model_type') == 'real')"/>
    <arg name="sdf_file" value="$(find eagle_mpc_python)/models/sdf/s500_uam/s500_uam_ideal.sdf" if="$(eval arg('model_type') == 'ideal')"/>
    <arg name="sdf_file" value="$(find eagle_mpc_python)/models/sdf/s500_uam/s500_uam_no_friction.sdf" if="$(eval arg('model_type') == 'no_friction')"/>
    <arg name="sdf_file" value="$(find eagle_mpc_python)/models/sdf/s500_uam/s500_uam_no_motor_constant.sdf" if="$(eval arg('model_type') == 'no_motor_constant')"/>
    <arg name="sdf_file" value="$(find eagle_mpc_python)/models/sdf/s500_uam/s500_uam_camera.sdf" if="$(eval arg('model_type') == 'camera')"/>

    <!-- gazebo configs -->
    <arg name="gui" default="true"/>
    <arg name="debug" default="false"/>
    <arg name="verbose" default="false"/>
    <arg name="paused" default="true"/>
    <!-- s500_uam 带臂：须先 pause 再加载控制器，否则 spawn 后关节无力矩会砸地弹跳。
         auto_unpause 在臂 position 控制器就绪并预置关节角后自动 unpause。 -->
    <arg name="auto_unpause" default="true"/>
    <arg name="respawn_gazebo" default="false"/>
    <arg name="launch_rviz" default="true"/>
    <arg name="launch_reference_path_pub" default="true"/>
    <arg name="show_uav_model_in_rviz" default="true"/>
    <arg name="rviz_config" default="$(find eagle_mpc_python)/config/rviz/s500_mpc_debug.rviz"/>
    
    <!-- PX4 configs -->
    <arg name="interactive" default="true"/>

    <!-- MAVROS configs -->
    <arg name="fcu_url" default="udp://:14540@localhost:14557"/>
    <arg name="respawn_mavros" default="false"/>

    <!-- PX4 SITL -->
    <arg unless="$(arg interactive)" name="px4_command_arg1" value="-d"/>
    <arg     if="$(arg interactive)" name="px4_command_arg1" value=""/>
    <node name="sitl" pkg="px4" type="px4" output="screen"
        args="$(find px4)/build/px4_sitl_default/etc -s etc/init.d-posix/rcS $(arg px4_command_arg1)" required="true"/>

    <!-- Gazebo sim add arm initial position-->
    <arg name="x" default="-1.5"/>
    <arg name="y" default="0"/>
    <arg name="z" default="0.37" if="$(eval arg('world_name') == 'table_beer_with_stand')"/>
    <arg name="z" default="0.2" unless="$(eval arg('world_name') == 'table_beer_with_stand')"/>
    <arg name="joint_1_pos" default="-1.2"/>
    <arg name="joint_2_pos" default="-0.6"/>
    <arg name="joint_3_pos" default="0.0"/>
    <arg name="joint_4_pos" default="0.0"/>
    <include file="$(find gazebo_ros)/launch/empty_world.launch">
        <arg name="gui" value="$(arg gui)"/>
        <arg name="world_name" value="$(arg world)"/>
        <arg name="debug" value="$(arg debug)"/>
        <arg name="verbose" value="$(arg verbose)"/>
        <arg name="paused" value="$(arg paused)"/>
        <arg name="respawn_gazebo" value="$(arg respawn_gazebo)"/>
    </include>
    <!-- gazebo model -->
    <node name="$(anon vehicle_spawn)" pkg="gazebo_ros" type="spawn_model" output="screen" args="-sdf -file $(arg sdf_file) -model $(arg vehicle) -x $(arg x) -y $(arg y) -z $(arg z) -J joint_1 $(arg joint_1_pos) -J joint_2 $(arg joint_2_pos) -J joint_3 $(arg joint_3_pos) -J joint_4 $(arg joint_4_pos)" />

    <include file="$(find mavros)/launch/node.launch">
        <arg name="pluginlists_yaml" value="$(find eagle_mpc_python)/config/mavros/px4_sitl_pluginlists.yaml"/>
        <arg name="config_yaml" value="$(find mavros)/launch/px4_config.yaml"/>
        <arg name="fcu_url" value="$(arg fcu_url)"/>
        <arg name="gcs_url" value=""/>
        <arg name="tgt_system" value="1"/>
        <arg name="tgt_component" value="1"/>
        <arg name="log_output" value="screen"/>
        <arg name="fcu_protocol" value="v2.0"/>
        <arg name="respawn_mavros" value="$(arg respawn_mavros)"/>
    </include>

    <!-- robot description -->
    <param name="robot_description" command="$(find xacro)/xacro $(find eagle_mpc_python)/models/urdf/s500_uam_arm_$(arg arm_control_mode).urdf.xacro"/>

    <!-- arm controller -->
    <rosparam ns="arm_controller" file="$(find eagle_mpc_python)/config/arm_controllers_$(arg arm_control_mode).yaml" command="load"/>

    <!-- Spawn controllers with correct namespace and controller manager -->
    <node name="spawn_arm_controllers" pkg="controller_manager" type="spawner" output="screen"
        args="
        joint_state_controller
        joint_1_controller
        joint_2_controller
        joint_3_controller
        joint_4_controller
        "
        ns="arm_controller"
        respawn="false">
        <param name="use_sim_time" value="true"/>
    </node>

    <node pkg="eagle_mpc_python" type="gazebo_unpause_after_arm_ready.py"
          name="gazebo_unpause_after_arm_ready" output="screen"
          if="$(arg auto_unpause)"
          launch-prefix="bash -c 'sleep 2.0; exec $0 $@' ">
        <param name="auto_unpause" value="$(arg auto_unpause)"/>
        <param name="controller_ns" value="arm_controller"/>
        <param name="hold_sec" value="0.5"/>
        <param name="post_unpause_hold_sec" value="1.5"/>
        <param name="switch_timeout_sec" value="4.0"/>
        <param name="controller_wait_sec" value="90.0"/>
        <param name="joint_1" value="$(arg joint_1_pos)"/>
        <param name="joint_2" value="$(arg joint_2_pos)"/>
        <param name="joint_3" value="$(arg joint_3_pos)"/>
        <param name="joint_4" value="$(arg joint_4_pos)"/>
    </node>

    <!-- Launch Joint PID Controller -->
    <!-- <node name="joint_pid_controller" pkg="eagle_mpc_python" type="joint_pid_controller.py" output="screen">
    </node> -->
    
    <!-- Optional: Launch rqt_reconfigure for easy parameter tuning -->
    <!-- <node name="rqt_reconfigure" pkg="rqt_reconfigure" type="rqt_reconfigure" output="screen" /> -->

    <!-- gazebo state-->
    <node pkg="eagle_mpc_python" type="groundtruth_pub.py" name="groundtruth_pub" output="screen">
        <param name="model_name" value="$(arg vehicle)" />
    </node>

    <!-- 默认无扰动，避免上次会话 rosparam 残留导致 RViz 一启动就有箭头 -->
    <rosparam param="/suite_mpc/disturbance_config">{active: false}</rosparam>

    <node pkg="eagle_mpc_python" type="gazebo_disturbance_viz_node.py"
          name="gazebo_disturbance_viz" output="screen">
        <param name="publish_hz" value="10"/>
    </node>

    <node pkg="eagle_mpc_python" type="reference_path_pub.py" name="reference_path_pub" output="screen" if="$(arg launch_reference_path_pub)">
        <param name="reference_pose_topic" value="/reference/pose" />
        <param name="reference_path_topic" value="/reference/path" />
        <param name="path_frame_id" value="map" />
        <param name="max_path_length" value="3000" />
    </node>

    <node pkg="rviz" type="rviz" name="rviz" args="-d $(arg rviz_config)" if="$(arg launch_rviz)" />

    <group if="$(arg show_uav_model_in_rviz)">
        <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher" output="screen" />
        <node pkg="eagle_mpc_python" type="pose_to_tf_pub.py" name="pose_to_tf_pub" output="screen">
            <param name="pose_topic" value="/mavros/vision_pose/pose" />
            <param name="parent_frame" value="map" />
            <param name="child_frame" value="base_link" />
        </node>
    </group>

</launch>
